PORT=4001

# Своя ОТДЕЛЬНАЯ база данных — НЕ та же, что у messenger-server.
# Создай отдельный Postgres (свой Render Postgres, отдельно от чатов).
DATABASE_URL=postgres://user:password@host:5432/identity
PGSSL=false

# Общий с messenger-server секрет для подписи токенов входа
JWT_SECRET=такой-же-как-в-messenger-server

# Ключ шифрования номеров телефонов (AES-256-GCM) — своя длинная строка
PHONE_ENCRYPTION_KEY=замени-на-свою-длинную-случайную-строку

# Ключ для детерминированного поиска по номеру (HMAC) — другая длинная строка
PHONE_HASH_KEY=замени-на-другую-длинную-случайную-строку

# ГЛАВНЫЙ ключ защиты: без него сервер вообще не запустится.
# Его же нужно прописать в messenger-server как IDENTITY_INTERNAL_KEY —
# это "пароль", которым messenger-server стучится сюда, и никто другой
# постучаться не сможет, даже зная адрес сервера.
INTERNAL_API_KEY=сгенерируй-очень-длинную-случайную-строку
