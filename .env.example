PORT=4001

# Своя ОТДЕЛЬНАЯ база данных — НЕ та же, что у messenger-server.
# Создай отдельный Postgres (свой Render Postgres, отдельно от чатов).
DATABASE_URL=postgres://user:password@host:5432/identity
PGSSL=false

# Общий с messenger-server секрет для подписи токенов входа
JWT_SECRET=такой-же-как-в-messenger-server

# Ключ шифрования номеров телефонов (AES-256-GCM) — своя длинная строка
PHONE_ENCRYPTION_KEY=замени-на-свою-длинную-случайную-строку

# Ключ для детерминированного поиска по номеру (HMAC) — другая длинная строка
PHONE_HASH_KEY=замени-на-другую-длинную-случайную-строку

# ГЛАВНЫЙ ключ защиты: без него сервер вообще не запустится.
# Его же нужно прописать в messenger-server как IDENTITY_INTERNAL_KEY —
# это "пароль", которым messenger-server стучится сюда, и никто другой
# постучаться не сможет, даже зная адрес сервера.
INTERNAL_API_KEY=сгенерируй-очень-длинную-случайную-строку

# SMS.ru — реальная отправка кода на настоящий телефон (получить: sms.ru → Настройки → API)
# Без этой переменной код просто печатается в консоль (dev-режим, тоже рабочий вариант для теста)
SMSRU_API_ID=твой-api-id-с-sms.ru

# --- Telegram-бот: бесплатная навсегда доставка кода входа ---
# 1. В Telegram напиши @BotFather → /newbot → придумай имя и юзернейм бота
# 2. Скопируй токен, который он выдаст, в TELEGRAM_BOT_TOKEN
# 3. Юзернейм бота (без @) впиши в TELEGRAM_BOT_USERNAME
# Без этих двух переменных — просто работает dev-режим/SMS.ru, ничего не сломается
TELEGRAM_BOT_TOKEN=твой-токен-от-BotFather
TELEGRAM_BOT_USERNAME=your_bot_username

# Секрет для проверки, что вебхук реально дергает Telegram, а не кто-то ещё
TELEGRAM_WEBHOOK_SECRET=сгенерируй-случайную-строку

# На Render подставляется само (RENDER_EXTERNAL_URL) — руками не трогай.
# Нужно только если разворачиваешь не на Render:
# PUBLIC_URL=https://твой-публичный-адрес.example.com
